[Unit]
Description=Quest casting Chromium window
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XAUTHORITY=%h/.Xauthority
Environment=CG_QUEST_URL=https://horizon.meta.com/casting/
Environment=CG_QUEST_PROFILE_DIR=%h/.config/cg-overlay-box/chromium-quest
Environment=CHROME_DEBUG_PORT=9223

ExecStartPre=/usr/bin/mkdir -p %h/.config/cg-overlay-box/chromium-quest
ExecStart=/usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --disable-features=TranslateUI \
  --disable-notifications \
  --autoplay-policy=no-user-gesture-required \
  --remote-debugging-port=${CHROME_DEBUG_PORT} \
  --user-data-dir=${CG_QUEST_PROFILE_DIR} \
  --app=${CG_QUEST_URL}
ExecStartPost=/bin/sh -lc 'sleep 3; DISPLAY=:0 XAUTHORITY=%h/.Xauthority xset s off; DISPLAY=:0 XAUTHORITY=%h/.Xauthority xset -dpms; DISPLAY=:0 XAUTHORITY=%h/.Xauthority xset s noblank'

Restart=always
RestartSec=2

[Install]
WantedBy=default.target